{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/page.js": {
      "includeFiles": "api/_pages/**"
    },
    "api/project.js": {
      "includeFiles": "api/_pages/**"
    },
    "api/support.js": {
      "includeFiles": "api/_pages/**"
    },
    "api/admin.js": {
      "includeFiles": "api/_pages/**",
      "maxDuration": 60
    },
    "api/tramonto-proposal.js": {
      "includeFiles": "api/_pages/**"
    }
  },
  "redirects": [
    {
      "source": "/anita",
      "destination": "/141nanita",
      "permanent": false
    },
    {
      "source": "/anita/:rest*",
      "destination": "/141nanita/:rest*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/start",
      "destination": "/api/page?view=start"
    },
    {
      "source": "/dashboard",
      "destination": "/api/page?view=dashboard"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/help",
      "destination": "/api/support"
    },
    {
      "source": "/141nanita",
      "destination": "/api/page?project=anita"
    },
    {
      "source": "/141nanita/:role(homeowner|client|gc|trade|designer|bid)",
      "destination": "/api/page?project=anita&role=:role"
    },
    {
      "source": "/2560coolidge",
      "destination": "/api/page?project=coolidge"
    },
    {
      "source": "/2560coolidge/:role(homeowner|client|gc|trade|designer|bid)",
      "destination": "/api/page?project=coolidge&role=:role"
    },
    {
      "source": "/tramonto-proposal",
      "destination": "/api/tramonto-proposal"
    },
    {
      "source": "/tramonto",
      "destination": "/api/page?project=tramonto"
    },
    {
      "source": "/tramonto/:role(homeowner|client|gc|trade|designer|sub|bid)",
      "destination": "/api/page?project=tramonto&role=:role"
    },
    {
      "source": "/:path([a-z0-9][a-z0-9-]{2,60})",
      "destination": "/api/page?path=:path"
    },
    {
      "source": "/:path([a-z0-9][a-z0-9-]{2,60})/:role(homeowner|client|gc|trade|designer|bid)",
      "destination": "/api/page?path=:path&role=:role"
    }
  ]
}